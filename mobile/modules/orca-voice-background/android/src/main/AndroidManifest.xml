<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Orca Voice fork: keeps Orca reading agent replies aloud with the screen off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Orca Voice fork: installs its own builds from the fork's GitHub releases. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- Lets Orca update itself without the installer's screens (Android 12+). -->
  <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
  <application>
    <!-- Orca Voice fork: agent replies as Android Auto messages (CarMessaging.kt). -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />
    <!-- Orca Voice fork: Orca's agents as a media list in Android Auto (CarMediaBrowser.kt). -->
    <service
      android:name="expo.modules.orcavoicebackground.CarMediaBrowser"
      android:exported="true"
      android:label="Orca">
      <intent-filter>
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>
    <!-- Orca Voice fork: Orca's own screen in Android Auto (OrcaCarApp.kt). -->
    <meta-data
      android:name="androidx.car.app.minCarApiLevel"
      android:value="1" />
    <service
      android:name="expo.modules.orcavoicebackground.OrcaCarAppService"
      android:exported="true"
      android:label="Orca">
      <intent-filter>
        <action android:name="androidx.car.app.CarAppService" />
        <category android:name="androidx.car.app.category.IOT" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.orcavoicebackground.CarMessageReceiver"
      android:exported="false" />
    <service
      android:name="expo.modules.orcavoicebackground.ReadAloudService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
    <service
      android:name="expo.modules.orcavoicebackground.UpdateDownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <receiver
      android:name="expo.modules.orcavoicebackground.UpdateInstallReceiver"
      android:exported="false" />
    <receiver
      android:name="expo.modules.orcavoicebackground.UpdateReplacedReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <provider
      android:name="expo.modules.orcavoicebackground.UpdateFileProvider"
      android:authorities="${applicationId}.orcavoice.updates"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/orca_voice_update_paths" />
    </provider>
  </application>
</manifest>
