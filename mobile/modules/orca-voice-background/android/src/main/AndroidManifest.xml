<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Orca Voice fork: keeps Orca reading agent replies aloud with the screen off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Orca Voice fork: installs its own builds from the home server. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <application>
    <service
      android:name="expo.modules.orcavoicebackground.ReadAloudService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
    <!-- Orca Voice fork: the Quick Settings tile that mutes auto-read for now. -->
    <service
      android:name="expo.modules.orcavoicebackground.ReadAloudTileService"
      android:exported="true"
      android:icon="@drawable/orca_voice_volume_up"
      android:label="Read aloud"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
        android:name="android.service.quicksettings.TOGGLEABLE_TILE"
        android:value="true" />
    </service>
    <provider
      android:name="expo.modules.orcavoicebackground.UpdateFileProvider"
      android:authorities="${applicationId}.orcavoice.updates"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/orca_voice_update_paths" />
    </provider>
  </application>
</manifest>
